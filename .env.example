# ==============================================================================
# SmartPrompt AI Environment Configuration
# Copy this file to `.env` for local development. Never commit `.env` to git.
# ==============================================================================

# --- Execution Mode ("offline" or "online") ---
# offline: Localhost Streamlit + FastAPI, SQLite DB, local Scikit-learn/Joblib models,
#          and zero external API or internet dependency.
# online:  Cloud-ready host bindings (0.0.0.0), optional PostgreSQL via DATABASE_URL,
#          ephemeral temp workspace, and optional server-side online AI API enrichment.
EXECUTION_MODE="offline"
STRICT_ONLINE_MODE="false"

# --- Application & Server Ports ---
APP_NAME="SmartPrompt AI"
APP_ENV="development"
API_HOST="127.0.0.1"
API_PORT=8000
API_BASE_URL="http://127.0.0.1:8000"
STREAMLIT_HOST="127.0.0.1"
STREAMLIT_PORT=8501
APP_URL="MY_APP_URL"
CORS_ALLOWED_ORIGINS="http://localhost:8501,http://127.0.0.1:8501"

# --- Database Configuration ---
# In offline mode, SQLite is used automatically via SQLITE_DB_PATH.
# In online mode, set DATABASE_URL (e.g., postgresql+psycopg2://user:pass@host:5432/smartprompt_ai).
SQLITE_DB_PATH="data/smartprompt_ai.db"
DATABASE_URL=""
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- Online AI Integration (Used only when EXECUTION_MODE="online") ---
# Leave AI_PROVIDER="local" for 100% deterministic local prompt rewriting.
# Set AI_PROVIDER="gemini" and inject GEMINI_API_KEY securely via server environment secrets.
AI_PROVIDER="local"
GEMINI_API_KEY="MY_GEMINI_API_KEY"
ONLINE_AI_MODEL="gemini-2.5-flash"
AI_REQUEST_TIMEOUT_SEC=20

# --- Storage, Session Cleanup & Upload Limits ---
# In online mode, storage automatically uses the OS temp directory unless overridden.
DATA_DIR="data"
MODELS_DIR="ml_models"
REPORTS_DIR="reports"
MAX_UPLOAD_SIZE_MB=50
SESSION_TTL_SECONDS=1800
MAX_ACTIVE_SESSIONS=30

# --- Logging Configuration ---
LOG_LEVEL="INFO"
ENABLE_FILE_LOGGING="true"
LOG_DIR="logs"
LOG_FILE_NAME="smartprompt_ai.log"
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=3
